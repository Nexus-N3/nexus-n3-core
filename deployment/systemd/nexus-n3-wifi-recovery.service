[Unit]
Description=Nexus N3 fixed-purpose sensor Wi-Fi recovery

[Service]
Type=oneshot
User=root
Environment=NEXUS_WIFI_REGULATORY_DOMAIN=EE
EnvironmentFile=-/etc/nexus-n3/wifi-recovery.env
ExecStart=/usr/bin/systemctl restart wpa_supplicant.service
ExecStart=/usr/bin/systemctl restart NetworkManager.service
ExecStart=/usr/bin/sleep 5
ExecStart=/usr/sbin/iw reg set ${NEXUS_WIFI_REGULATORY_DOMAIN}
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
