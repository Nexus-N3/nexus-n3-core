[Unit]
Description=Nexus N3 Core Standalone Node
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/apps/dev/nexus-n3-project/nexus-n3-core
Environment=NEXUS_N3_ENV_FILE=/etc/nexus-n3/runtime.env
EnvironmentFile=-/etc/nexus-n3/runtime.env
ExecStart=/usr/bin/env python3 %h/Desktop/apps/dev/nexus-n3-project/nexus-n3-core/nexus_n3_server.py --role standalone --admin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
