interface={{ nexus_ap_interface }}
bind-dynamic
port=0

dhcp-authoritative
dhcp-range={{ nexus_ap_dhcp_range_start }},{{ nexus_ap_dhcp_range_end }},{{ nexus_ap_dhcp_netmask }},{{ nexus_ap_dhcp_lease }}

# Do not advertise the Nexus node as an Internet router.
dhcp-option=option:router

# DNS is disabled; .local names are resolved through mDNS/Avahi.
dhcp-option=option:dns-server
