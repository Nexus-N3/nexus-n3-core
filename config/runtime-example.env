# nexus-n3-core shared runtime environment
# Local development defaults live here. Production deployments should render
# the same variable set into /etc/nexus-n3/runtime.env.

# Core
NEXUS_N3_NEIA_APPS_CATALOG_URL=http://127.0.0.1:8050/api/v1/apps/catalog
NEXUS_ADMIN_DISPLAY_PROFILE=
NEXUS_PERF_LOG=0
NEXUS_N3_OUTPUT_ROOT=/path/to/nexus-n3-core/nexus_n3_outputs
NEXUS_N3_LOG_ROOT=/path/to/nexus-n3-core/nexus_n3_logs

# Plugin runtime
#NEXUS_N3_PLUGIN_ROOT=/opt/nexus-n3-plugins # production
NEXUS_N3_PLUGIN_ROOT=/tmp/nexus-n3-plugins # local dev
NEXUS_N3_PLUGIN_USE_SYSTEM_SITE_PACKAGES=0 #shouldn this be 0 by default to ensure isolation?
NEXUS_N3_BOOTSTRAP_PLUGINS=0
NEXUS_N3_BOOTSTRAP_PLUGIN_LIST=
# Docker example mount path. For direct host runs, use your local nexus-n3-plugin-catalog path.
NEXUS_N3_PLUGIN_CATALOG_ROOT=/path/to/nexus-n3-plugin-catalog

# BLE backend
BLE_BACKEND=nexus_ble_gateway
GATEWAY_SERIAL_PORT=/dev/serial/by-id/usb-ZEPHYR_IFMCU_CMSIS-DAP_820D9A5F0D64CFA48AEBA-if01
GATEWAY_BAUDRATE=1000000
GATEWAY_PROTOCOL_VERSION=1
GATEWAY_CONNECT_TIMEOUT_S=15.0
GATEWAY_SUBSCRIBE_TIMEOUT_S=5.0
GATEWAY_WRITE_TIMEOUT_S=5.0
GATEWAY_READ_TIMEOUT_S=5.0

# Local gateway transport
ZEROMQ_CMD_BIND=tcp://*:5555
ZEROMQ_EVENT_BIND=tcp://*:5556

# Azure bridge
AZURE_IOT_CONNECTION_STRING=
AZURE_IOT_DEVICE_ID=
AZURE_IOT_SITE=DLR Cologne Campus
AZURE_IOT_CUSTOMER_ID=customer-dlr 
AZURE_IOT_SITE_ID=Lunar-001
AZURE_IOT_SITE_NAME=Lunar
AZURE_IOT_UPLOAD_CONTAINER=nexusn3-session-uploads
AZURE_BRIDGE_LOCAL_CMD_ADDR=tcp://127.0.0.1:5555
AZURE_BRIDGE_LOCAL_EVT_ADDR=tcp://127.0.0.1:5556
AZURE_BRIDGE_REMOTE_CONTROL_ENABLED=0
AZURE_BRIDGE_STATE_FILE=/tmp/nexus_n3.azure_bridge_state.json
AZURE_BRIDGE_USE_WEBSOCKETS=1
AZURE_BRIDGE_KEEP_ALIVE=120
AZURE_BRIDGE_CONNECTION_RETRY_INTERVAL=15
AZURE_BRIDGE_UPLOAD_RETRY_INTERVAL=5

# Robot runtime
NEXUS_N3_ROBOT_CONFIG=/etc/nexus-n3/robot.yaml
